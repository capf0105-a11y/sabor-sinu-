# ============================================================================
# Sabor Sinú · configuración de ejemplo
# Copia este archivo como .env y ajusta los valores reales.
# Nunca subas .env a Git.
# ============================================================================

# --- Entorno ---------------------------------------------------------------
ENVIRONMENT=development

# --- Marca y contacto (reemplaza los datos de ejemplo) ---------------------
BUSINESS_NAME=Sabor Sinú
BUSINESS_TAGLINE=Cocina rápida costeña
BUSINESS_PHONE=+57 304 466 7353
BUSINESS_WHATSAPP=573044667353
BUSINESS_NEQUI=304 466 7353
BUSINESS_LLAVE=304 466 7353
BUSINESS_ADDRESS=Calle 34 # 6-12, Centro, Montería, Córdoba
BUSINESS_HOURS=Lunes a domingo · 11:00 a.m. – 10:30 p.m.
BUSINESS_INSTAGRAM=@saborsinu

# --- Domicilios y tiempos --------------------------------------------------
DELIVERY_BASE_FEE=2000
FREE_DELIVERY_FROM=80000
PREP_MINUTES=25
DELIVERY_MINUTES=20
TIMEZONE=America/Bogota

# --- Correo automático -----------------------------------------------------
# Si SMTP_HOST y ADMIN_EMAILS están vacíos, el correo se guarda en
# data/outbox/{PEDIDO}.html y .txt (modo demo), sin enviar nada.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Sabor Sinú · Pedidos Web
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_TIMEOUT=15
ADMIN_EMAILS=pedidos@tudominio.com,administracion@tudominio.com
# Fuerza el modo demo aunque haya SMTP configurado:
EMAIL_DRY_RUN=false

# --- WhatsApp del vendedor (CallMeBot) -------------------------------------
# 1) Desde tu WhatsApp envía: "I allow callmebot to send me messages"
#    al número +34 644 51 95 23.
# 2) Recibirás una API key por WhatsApp; pégala en CALLMEBOT_API_KEY.
# Si está vacío, solo funciona el botón "Enviar por WhatsApp" del cliente.
WHATSAPP_ALERT_PHONE=573044667353
CALLMEBOT_API_KEY=

# --- Operación y seguridad -------------------------------------------------
# Token para /api/admin/*. Si queda vacío, el panel admin queda deshabilitado.
ADMIN_TOKEN=cambia-este-token-largo-y-aleatorio
# Orígenes permitidos si el frontend se sirve desde otro dominio.
# Ejemplo: https://saborsinu.com,https://www.saborsinu.com
ALLOWED_ORIGINS=
SESSION_TTL_MINUTES=180
RATE_LIMIT_PER_MINUTE=60
MAX_MESSAGE_CHARS=500

# --- Persistencia (opcional) ----------------------------------------------
# En producción monta un disco persistente y apunta estas rutas allí.
# DATA_DIR=C:/datos/sabor-sinu
# ORDERS_FILE=C:/datos/sabor-sinu/orders.json
# OUTBOX_DIR=C:/datos/sabor-sinu/outbox
